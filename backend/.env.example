DATABASE_URL="file:./dev.db"
PORT=3000

# REQUIRED. Generate a long random value per deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production (NODE_ENV=production) without this.
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret"

# Optional secondary key for the Super Admin licence-renewal endpoint.
MASTER_ADMIN_KEY="CHANGE_ME_master_admin_key"

# Master Developer / Super Admin Credentials (used during the initial database seed only).
# Change the password before seeding a real deployment.
SUPER_ADMIN_NAME="System Super Administrator"
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="CHANGE_ME_strong_password"
